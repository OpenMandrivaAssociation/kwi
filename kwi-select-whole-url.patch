+    // ':' stays inside a word, so a double-click selects a whole URL.
+    void urlWordSelection()
+    {
+        Terminal terminal{40, 2};
+        QVERIFY(terminal.resize(40, 2, {10, 20}));
+        terminal.feed("see https://lindev.ch/ now");
+        // Column 10 is the first '/' of "https://".
+        QVERIFY(clickSelection(terminal, {10, 0}, 2));
+        QCOMPARE(terminal.selectionText(), QStringLiteral("https://lindev.ch/"));
+        QVERIFY(clickSelection(terminal, {4, 0}, 2));
+        QCOMPARE(terminal.selectionText(), QStringLiteral("https://lindev.ch/"));
+        QVERIFY(gesture(terminal, SelectionEvent::Type::Drag, {23, 0}));
+        QCOMPARE(terminal.selectionText(), QStringLiteral("https://lindev.ch/ now"));
+
+        Terminal location{20, 1};
+        QVERIFY(location.resize(20, 1, {10, 20}));
+        location.feed("file.cpp:42");
+        QVERIFY(clickSelection(location, {0, 0}, 2));
+        QCOMPARE(location.selectionText(), QStringLiteral("file.cpp:42"));
+    }
