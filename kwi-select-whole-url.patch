+    // Ghostty's default boundaries include ':', so a double-click on
+    // "https://lindev.ch/" selects "//lindev.ch/". Drop the colon, matching
+    // Konsole's default word characters. Brackets stay boundaries.
+    if (input.type != SelectionEvent::Type::Release) {
+        // Ghostty default_word_boundaries, without ':'. 0x2502 is U+2502.
+        static constexpr std::array<uint32_t, 19> wordBoundaries{
+            0, ' ', '\t', '\'', '"', 0x2502, '`', '|', ';', ',', '(', ')', '[', ']', '{', '}', '<', '>', '$',
+        };
+        const GhosttyCodepoints boundaries{wordBoundaries.data(), wordBoundaries.size()};
+        ghostty_selection_gesture_event_set(event, GHOSTTY_SELECTION_GESTURE_EVENT_OPT_WORD_BOUNDARY_CODEPOINTS, &boundaries);
+    }
